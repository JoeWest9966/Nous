node_modules/
dist/
.DS_Store
*.local
.env
.env.*
!.env.example
.idea/
.vscode/
*.log

content/*/*.tmp

# content/ 整盘都在版本控制里（2024-11 起不再把运行时数据排除在外）：
# clone 下来就是完整盘面 —— tree.json、log.json、锁、块代码和数据全在。
# 只排除可再生的：嵌套 .git（块自己 git init 的历史不并入主仓）、node_modules、
# dist（构建产物）、*.log（audit.log 等带 IP 的活日志，见顶部全局规则）。
content/**/.git/

# sqlite 的 WAL 边车文件：随进程来去，提交它没意义（库本体照旧跟踪）。
content/**/*.sqlite-shm
content/**/*.sqlite-wal

# ── Rust workspace（#14 搬迁）────────────────────────────
/target
# 扩展的判据执行器也会生成 target/
**/*.rs.bk

# 真实用户数据，永不入库（spec：fixture 那份 agent.sqlite 是线上数据）
fixtures/*.sqlite
fixtures/*.sqlite-wal
fixtures/*.sqlite-shm
# 例外：脱敏小样本**要**进仓（#43）。它是 `scripts/make-small-fixture.py` 从真库生成的，
# 只有截断的字符串与归零的 usage/cost；CI 靠它真跑 §2 的 fixture 判据。
!fixtures/agent.small.sqlite

# vendor 里自带 Cargo.toml 的 daemon 单编会生成 target/
vendor/**/target/

# nous-server 的默认库（NOUS_DB 缺省 ./nous.db）：运行时产物，不入库
nous.db
nous.db-wal
nous.db-shm
