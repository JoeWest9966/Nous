[Unit]
Description=Nous kernel (nous-app) — /v1/* on 0.0.0.0:4789（token 必需）
Documentation=https://github.com/JoeWest9966/Nous
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nous
Group=nous
WorkingDirectory=/srv/nous/work
Environment=HOME=/var/lib/nous
# 绑非回环：NousDesk 永远不和 Nous 同机，只监听回环的话客户端连不上。
# 代价是「局域网可达」——所以这一行和下一行是**一对**：没有 token 文件，
# 进程会 `refuse: no-token-on-non-loopback` 退出 78（不是裸奔启动）。
Environment=NOUS_LISTEN=0.0.0.0:4789
Environment=NOUS_DB=/var/lib/nous/nous.db
Environment=NOUS_TOKEN_FILE=/etc/nous/token
# 供应商密钥：元素包里只存 `$ENV` 引用（`$WB2API_API_KEY` …），值放这个文件，
# root:nous 0640，不进 git。`-` = 文件可以不存在（没配密钥也能启动，只是轮次会
# 明确报错而不是静默不出声）。密钥只在启动时解一次，换密钥要 restart。
EnvironmentFile=-/etc/nous/providers.env
ExecStart=/opt/nous-app/current/nous-app
# 78 = EX_CONFIG：拒绝启动（库比代码新 / 没 token / workdir 不可写 …）。
# on-failure + PreventExitStatus=78 让「不想起」停在 failed，而不是每 3 秒拉一次。
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=3

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
