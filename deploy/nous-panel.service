[Unit]
Description=Nous (panel) — vite preview on 0.0.0.0:4790
Documentation=https://github.com/JoeWest9966/Nous
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/Nous
Environment=NODE_ENV=production
Environment=NOUS_HOST=0.0.0.0
# 反代把我们挂在子路径下时写这个（Tailscale serve: `--set-path=/nous`）。
# 前缀在到达本进程之前就被剥掉了，也不保证有 `X-Forwarded-Prefix` —— 只能靠配置告诉它。
# 没有前缀就删掉这行（块会拿 `http://localhost:4790` 当自己的地址）。
Environment=NOUS_BASE=/nous
ExecStart=/usr/bin/node /opt/Nous/node_modules/vite/bin/vite.js preview --host 0.0.0.0 --port 4790
Restart=always
RestartSec=3

# 日志走 journald: journalctl -u nous-panel -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# 安装：cp deploy/nous-panel.service /etc/systemd/system/
#       systemctl daemon-reload && systemctl enable --now nous-panel
# 先 npm ci && npm run build，preview 读的是 dist/。
