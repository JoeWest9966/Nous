      "version": "0.3.0",
      "kind": "编译期",
      "layer": "app",
      "required": false,
      "crate": "`nous-skills`",
      "vendor": "Nous",
      "description": "默认根 `NOUS_SKILLS=/opt/Nous-skills`（#63，路径解析归 `env`）；`SKILL.md` frontmatter / 附件 / 类别词表解析仍在 `lib.rs`；盘面规矩（名字 / 路径校验、递归清单、骨架落盘、发布）在 `nous_repo::entries`，与 `prompts` / `ext` 共用同一份；不 spawn git（发布走 `nous-repo`）",
      "enabled": true,
      "endpoints": [
        "GET /v1/skills",
        "GET /v1/skills/files",
        "GET /v1/skills/file",
        "PUT /v1/skills/file",
        "POST /v1/skills/create",
        "POST /v1/skills/publish"
      ]
    },
    {
      "name": "archive",
      "version": "0.2.0",
      "kind": "编译期",
      "layer": "app",
      "required": false,
      "crate": "`data-archive`",
      "vendor": "Data",
      "description": "三条端点自带 handler（`crates/Data/Archive/src/routes.rs`）；供应商 `data`，包名 `data-archive`",
