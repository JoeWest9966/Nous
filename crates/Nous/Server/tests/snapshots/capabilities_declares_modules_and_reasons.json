    {
      "name": "env",
      "version": "0.3.1",
      "kind": "编译期",
      "layer": "platform",
      "required": true,
      "crate": "`nous-env`",
      "vendor": "Nous",
      "description": "契约；实现见 `env-local` / `env-ssh`。`NOUS_SKILLS` / `NOUS_PROMPTS` / `NOUS_PRESETS` / `NOUS_EXTEND` 一处解析，unit 不写；写回私库归 `skills-admin` / `presets-admin`。自带 `GET /v1/fs/dirs`（远端分支是宿主能力 trait：`nous-env-ssh` 的 requires 里有本 crate，反向依赖会成环）",
      "enabled": true,
      "endpoints": [
        "GET /v1/fs/dirs"
      ]
    },
