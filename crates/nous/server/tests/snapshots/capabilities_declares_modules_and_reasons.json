        "code": "not_implemented",
        "message": "archive 模块尚未落地"
      }
    },
    {
      "name": "combos",
      "enabled": false,
      "reason": {
        "code": "not_implemented",
        "message": "combos 模块尚未落地"
      }
    },
    {
      "name": "triggers",
      "enabled": true,
      "endpoints": [
        "GET /v1/triggers",
        "POST /v1/triggers/{code}/fire",
        "GET /v1/triggers/{code}/fires"
      ]
    },
    {
      "name": "stats",
      "enabled": true,
      "endpoints": [
