{
  "contract": 1,
  "server": {
    "name": "nous",
    "version": "0.1.23"
  },
  "modules": [
    {
      "name": "sessions",
      "version": "0.1.23",
      "kind": "编译期",
      "layer": "app",
      "required": true,
      "crate": "`nous-sessions`",
      "description": "**pi 本体**（#44 落地），承载最小轮次与取消收敛",
      "enabled": true,
      "endpoints": [
        "GET /v1/sessions",
        "GET /v1/unread",
        "GET /v1/origins",
        "POST /v1/read/:id",
        "POST /v1/sessions",
        "GET /v1/sessions/:id/entries",
        "POST /v1/sessions/:id/messages",
        "GET /v1/sessions/:id/events",
        "POST /v1/sessions/:id/abort",
        "POST /v1/sessions/:id/fork",
        "POST /v1/sessions/:id/rename",
        "POST /v1/sessions/:id/pin",
        "POST /v1/sessions/:id/config",
        "POST /v1/sessions/:id/purge",
        "GET /v1/selection",
        "POST /v1/selection",
        "GET /v1/search"
      ]
    },
    {
      "name": "env",
      "version": "0.1.23",
      "kind": "编译期",
      "layer": "platform",
      "required": true,
      "crate": "`nous-env`",
      "description": "契约；实现见 `env-local` / `env-ssh`。`NOUS_SKILLS` / `NOUS_PROMPTS` / `NOUS_PRESETS` / `NOUS_EXTEND` 一处解析，unit 不写；写回私库归 `skills-admin` / `presets-admin`",
      "enabled": true,
      "endpoints": [
        "GET /v1/fs/dirs"
      ]
    },
    {
      "name": "repo",
      "version": "0.1.23",
      "kind": "编译期",
      "layer": "platform",
      "required": true,
      "crate": "`nous-repo`",
      "description": "唯一的 git 进程调用面；四条私库路径解析沿用 `env`",
      "enabled": true,
      "endpoints": [
        "GET /v1/repos/:repo/status",
        "GET /v1/repos/:repo/pending",
        "GET /v1/repos/:repo/pending/diff",
        "GET /v1/repos/:repo/pending/commit",
        "GET /v1/repos/:repo/history",
        "GET /v1/repos/:repo/history/diff",
        "POST /v1/repos/:repo/commit",
        "GET /v1/repos/:repo/archive",
        "POST /v1/repos/:repo/archive",
        "POST /v1/repos/:repo/restore",
        "POST /v1/repos/:repo/purge",
        "GET /v1/repos/:repo/variants",
        "POST /v1/repos/:repo/variants/bind",
        "POST /v1/repos/:repo/variants/unbind",
        "POST /v1/repos/:repo/variants/branch",
        "POST /v1/repos/:repo/variants/publish",
        "POST /v1/repos/:repo/variants/prune",
        "GET /v1/repos/:repo/variants/usage",
        "GET /v1/repos/:repo/sources",
        "POST /v1/repos/:repo/sources",
        "GET /v1/repos/:repo/upstream",
        "POST /v1/repos/:repo/upstream/refresh",
        "POST /v1/repos/:repo/upstream/pin",
        "POST /v1/repos/:repo/upstream/check",
        "POST /v1/repos/:repo/upstream/sync",
        "GET /v1/repos/:repo/upstream/tree",
        "GET /v1/repos/:repo/upstream/file",
        "GET /v1/repos/:repo/upstream/files",
        "POST /v1/repos/:repo/upstream/copy",
        "POST /v1/repos/:repo/upstream/adopt"
      ]
    },
    {
      "name": "presets",
      "version": "0.1.23",
      "kind": "编译期",
      "layer": "app",
      "required": false,
      "crate": "—",
      "description": "数据根 `NOUS_PRESETS=/opt/Nous-Template`（#63；段清单读 `<root>/sections.json`，路径解析归 `env`）",
      "enabled": true,
      "endpoints": [
        "GET /v1/presets",
        "GET /v1/presets/model",
        "GET /v1/presets/{section}",
        "PUT /v1/presets/{section}/order",
        "GET /v1/presets/{section}/categories",
        "GET /v1/presets/{section}/{name}",
        "PUT /v1/presets/{section}/{name}",
        "PATCH /v1/presets/{section}/{name}",
        "DELETE /v1/presets/{section}/{name}",
        "POST /v1/presets/{section}/{name}/copy",
        "GET /v1/presets/{section}/{name}/revisions",
        "GET /v1/presets/{section}/{name}/revisions/{n}",
        "POST /v1/presets/{section}/{name}/rollback"
      ]
    },
    {
      "name": "presets-admin",
      "version": "0.1.23",
      "kind": "编译期",
      "layer": "app",
      "required": false,
      "crate": "`nous-presets-admin`",
      "description": "从 TS 内核 `presets.js` 750 + `presets-api.js` 947 归位；段清单读 `<root>/sections.json`",
      "enabled": true,
      "endpoints": [
        "GET /v1/presets/{section}/order",
        "POST /v1/presets/{section}/categories",
        "POST /v1/presets/{section}/category",
        "POST /v1/presets/{section}/create",
        "POST /v1/presets/{section}/rename",
        "POST /v1/presets/{section}/archive",
        "POST /v1/presets/{section}/restore",
        "POST /v1/presets/{section}/purge",
        "GET /v1/presets/{section}/validate",
        "POST /v1/presets/{section}/validate",
        "GET /v1/presets/{section}/resolve",
        "POST /v1/presets/{section}/resolve",
        "GET /v1/presets/{section}/files",
        "GET /v1/presets/{section}/file",
        "PUT /v1/presets/{section}/file",
        "GET /v1/presets/{section}/pending",
        "POST /v1/presets/{section}/sync",
        "POST /v1/presets/{section}/publish",
        "POST /v1/presets/{section}/reload"
      ]
    },
    {
      "name": "skills",
      "version": "0.1.23",
      "kind": "声明式",
      "layer": "app",
      "required": false,
      "crate": "`nous-skills`",
      "description": "数据；默认根 `NOUS_SKILLS=/opt/Nous-skills`（#63，路径解析归 `env`）；只列盘上真相，不碰 git（发布走 `nous-repo`）",
      "enabled": true,
      "endpoints": [
        "GET /v1/skills",
        "GET /v1/skills/files",
        "GET /v1/skills/file",
        "PUT /v1/skills/file",
        "POST /v1/skills/create",
        "POST /v1/skills/publish"
      ]
    },
    {
      "name": "archive",
      "version": "0.1.23",
      "kind": "编译期",
      "layer": "app",
      "required": false,
      "crate": "—",
      "description": "面板时代归档端点；Rust 版只落地了真删 + 墓碑，完整四方法另票",
      "enabled": true,
      "endpoints": [
        "POST /v1/sessions/:id/archive",
        "GET /v1/archive",
        "POST /v1/archive/{id}/restore"
      ]
    },
    {
      "name": "combos",
      "version": "0.1.23",
      "kind": "编译期",
      "layer": "app",
      "required": false,
      "crate": "—",
      "description": "数据根 `NOUS_PRESETS`（与 `presets` 同根）；触发器存在性从 `NOUS_TRIGGER` 目录读",
      "enabled": true,
      "endpoints": [
        "GET /v1/combos/:section",
        "PATCH /v1/combos/:section/:name",
        "POST /v1/combos/{section}/{name}/fire",
        "POST /v1/presets/Ultimate-Template/launch"
      ]
    },
    {
      "name": "triggers",
      "version": "0.1.23",
      "kind": "运行时外挂",
      "layer": "app",
      "required": false,
      "crate": "—",
      "description": "#57/#58 落地；调度节拍归 `dispatcher`",
      "enabled": true,
      "endpoints": [
        "GET /v1/triggers",
        "POST /v1/triggers",
        "GET /v1/triggers/categories",
        "POST /v1/triggers/category",
        "POST /v1/triggers/{code}/archive",
        "POST /v1/triggers/{code}/restore",
        "POST /v1/triggers/{code}/purge",
        "POST /v1/triggers/{code}/fire",
        "GET /v1/triggers/{code}/fires",
        "PATCH /v1/triggers/{code}",
        "PUT /v1/triggers/{code}",
        "GET /v1/trigger-projects",
        "GET /v1/trigger-projects/files",
        "GET /v1/trigger-projects/file",
        "PUT /v1/trigger-projects/file",
        "POST /v1/trigger-projects/create",
        "POST /v1/trigger-projects/publish",
        "POST /v1/trigger-projects/archive",
        "POST /v1/trigger-projects/restore",
        "POST /v1/trigger-projects/purge",
        "GET /v1/trigger-projects/categories",
        "POST /v1/trigger-projects/categories",
        "POST /v1/trigger-projects/category",
        "POST /v1/trigger-projects/sync"
      ]
    },
    {
      "name": "stats",
      "version": "0.1.23",
      "kind": "编译期",
      "layer": "app",
      "required": false,
      "crate": "`nous-stats`",
      "description": "归口监控六屏；与 `--check` 共读口，tasks 现算",
      "enabled": true,
      "endpoints": [
        "GET /v1/stats/usage",
        "GET /v1/stats/tasks",
        "GET /v1/stats/db",
        "GET /v1/stats/overview",
        "GET /v1/stats/conversations",
        "GET /v1/stats/conversation/:id",
        "GET /v1/stats/cost",
        "GET /v1/stats/health"
      ]
    },
    {
      "name": "device",
      "version": "0.1.23",
      "kind": "编译期",
      "layer": "app",
      "required": true,
      "crate": "`nous-device`",
      "description": "#65：从 server 提成独立插件；`/v1/models` 文件+内联来源，`PUT /v1/default` 原子写",
      "enabled": true,
      "endpoints": [
        "GET /v1/models",
        "PUT /v1/default",
        "POST /v1/catalog/refresh",
        "GET /v1/device",
        "GET /v1/capabilities",
        "GET /v1/openapi.json",
        "GET /v1/_routes",
        "GET /v1/machines"
      ]
    },
    {
      "name": "prompts",
      "version": "0.1.23",
      "kind": "编译期",
      "layer": "app",
      "required": true,
      "crate": "`nous-prompts`",
      "description": "今天 `prompts/index.js`",
      "enabled": true,
      "endpoints": [
        "GET /v1/prompts/files",
        "GET /v1/prompts/file",
        "PUT /v1/prompts/file",
        "POST /v1/prompts/create",
        "POST /v1/prompts/publish",
        "GET /v1/prompts"
      ]
    },
    {
      "name": "ext",
      "version": "0.1.23",
      "kind": "编译期",
      "layer": "app",
      "required": false,
      "crate": "`nous-ext`",
      "description": "已落地（#17–#37，#81 解冻：真清单 / 熔断 / 热重载，#84 补管理面）；`ext-host` 行是它后续的重划",
      "enabled": true,
      "endpoints": [
        "GET /v1/extensions/files",
        "GET /v1/extensions/file",
        "PUT /v1/extensions/file",
        "POST /v1/extensions/publish",
        "GET /v1/extensions",
        "POST /v1/extensions/reload",
        "POST /v1/extensions/create",
        "POST /v1/extensions/duplicate",
        "POST /v1/extensions/install",
        "POST /v1/extensions/uninstall",
        "GET /v1/extensions/categories",
        "POST /v1/extensions/categories",
        "GET /v1/extensions/trash",
        "POST /v1/extensions/trash/purge",
        "POST /v1/extensions/category"
      ]
    },
    {
      "name": "elements",
      "version": "0.1.23",
      "kind": "编译期",
      "layer": "app",
      "required": false,
      "crate": "`nous-elements`",
      "description": "元素库（组 / 包）：数据根 `NOUS_ELEMENTS=/opt/Nous-Elements`，一份 JSON 一个元素；旧面板 `k3skws` 块的 Rust 落点",
      "enabled": true,
      "endpoints": [
        "GET /v1/elements",
        "GET /v1/elements/{kind}",
        "GET /v1/elements/{kind}/{id}",
        "PUT /v1/elements/{kind}/{id}",
        "POST /v1/elements/{kind}",
        "DELETE /v1/elements/{kind}/{id}",
        "POST /v1/elements/{kind}/{id}/lock",
        "POST /v1/elements/push"
      ]
    }
  ],
  "runtime": {
    "provider": {
      "configured": false,
      "kind": "real",
      "message": "没有配置真实 provider 凭证，发消息会 503"
    }
  },
  "services": [
    {
      "name": "engine",
      "base": "http://127.0.0.1:4789"
    },
    {
      "name": "triggers",
      "base": "http://127.0.0.1:4789",
      "enabled": true
    }
  ]
}
